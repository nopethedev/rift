// Provider is rewritten from DATABASE_URL by scripts/db.mjs (sqlite | postgresql | mysql).
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String?
  passwordHash String
  role         String    @default("USER") // ADMIN | USER
  disabled     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]
  profiles     Profile[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  profileId  String?
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id        String          @id @default(cuid())
  userId    String
  name      String
  avatar    String          @default("violet")
  pinHash   String?
  isKids    Boolean         @default(false)
  // JSON string[] of taste-genre keys picked when the profile was created (see src/lib/taste.ts)
  favoriteGenres String?
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress  WatchProgress[]
  watchlist WatchlistItem[]
  streams   StreamSession[]
  musicPlaylists MusicPlaylist[]
  musicQueue     MusicQueueItem[]
  musicState     MusicQueueState?
  musicPlays     MusicPlay[]

  @@index([userId])
}

model WatchProgress {
  id          String    @id @default(cuid())
  profileId   String
  mediaFileId String
  titleId     String
  episodeId   String?
  positionSec Float     @default(0)
  durationSec Float     @default(0)
  completed   Boolean   @default(false)
  updatedAt   DateTime  @default(now()) @updatedAt
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@unique([profileId, mediaFileId])
  @@index([profileId, updatedAt])
}

model WatchlistItem {
  id         String   @id @default(cuid())
  profileId  String
  tmdbId     Int
  mediaType  String // movie | tv
  title      String
  posterPath String?
  createdAt  DateTime @default(now())
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, tmdbId, mediaType])
  @@index([profileId, createdAt])
}

model Setting {
  key   String @id
  value String
}

// A movie or a TV show in the library (local) — metadata cached from TMDB.
model Title {
  id           String    @id @default(cuid())
  type         String // movie | show
  tmdbId       Int?
  title        String
  originalTitle String?
  year         Int?
  overview     String?
  posterPath   String?
  backdropPath String?
  genres       String? // JSON array of {id,name}
  rating       Float?
  runtime      Int?
  releaseDate  String?
  tagline      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  seasons      Season[]
  episodes     Episode[]
  files        MediaFile[]

  @@unique([type, tmdbId])
  @@index([type, createdAt])
}

model Season {
  id         String    @id @default(cuid())
  titleId    String
  number     Int
  name       String?
  overview   String?
  posterPath String?
  title      Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodes   Episode[]

  @@unique([titleId, number])
}

model Episode {
  id        String      @id @default(cuid())
  titleId   String
  seasonId  String
  season    Int
  number    Int
  name      String?
  overview  String?
  stillPath String?
  runtime   Int?
  airDate   String?
  titleRef  Title       @relation(fields: [titleId], references: [id], onDelete: Cascade)
  seasonRef Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  files     MediaFile[]

  @@unique([titleId, season, number])
}

model MediaFile {
  id          String          @id @default(cuid())
  titleId     String? // set for movies
  episodeId   String? // set for episodes
  path        String          @unique // absolute path on disk
  size        BigInt          @default(0)
  container   String?
  durationSec Float?
  videoCodec  String?
  audioCodec  String?
  width       Int?
  height      Int?
  bitrate     Int?
  probe       String? // JSON: ProbeResult from shared/probe.ts
  status      String          @default("ready") // ready | unmatched | missing
  source      String          @default("import") // upload | import | torrent
  rawName     String? // original filename for unmatched files
  createdAt   DateTime        @default(now())
  title       Title?          @relation(fields: [titleId], references: [id], onDelete: SetNull)
  episode     Episode?        @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  subtitles   Subtitle[]
  progress    WatchProgress[]
  streams     StreamSession[]

  @@index([titleId])
  @@index([episodeId])
  @@index([status])
}

model Subtitle {
  id          String    @id @default(cuid())
  mediaFileId String
  language    String? // ISO 639-1/2 or free text
  label       String
  format      String // original format: srt | vtt | ass | embedded
  path        String // absolute path of the converted .vtt file
  source      String    @default("external") // external | embedded | upload
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@index([mediaFileId])
}

model Download {
  id            String    @id @default(cuid())
  infoHash      String    @unique
  name          String
  magnet        String? // magnet URI (when added by magnet)
  torrentPath   String? // stored .torrent file (when added by file)
  status        String    @default("queued") // queued | metadata | downloading | paused | seeding | completed | importing | imported | error
  size          BigInt    @default(0)
  downloaded    BigInt    @default(0)
  progress      Float     @default(0)
  savePath      String
  selectedFiles String? // JSON number[] of file indexes; null = all
  files         String? // JSON [{index,path,size}] after metadata
  error         String?
  // optional hint so the importer can link files without guessing
  tmdbId        Int?
  mediaType     String? // movie | tv
  season        Int?
  createdBy     String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  importedAt    DateTime?

  @@index([status])
}

// Heartbeat table for the "active streams" view.
model StreamSession {
  id          String    @id @default(cuid())
  userId      String
  profileId   String
  mediaFileId String
  mode        String // direct | mediabunny | hls
  detail      String? // e.g. "1080p -> 720p, audio eac3 -> opus"
  ip          String?
  startedAt   DateTime  @default(now())
  lastPingAt  DateTime  @default(now())
  positionSec Float     @default(0)
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@index([lastPingAt])
}

// ---------------------------------------------------------------------------------------------------------------
// Rift Music
// ---------------------------------------------------------------------------------------------------------------

// A file in the local music library (uploaded or imported from a library folder).
model MusicTrack {
  id          String   @id @default(cuid())
  path        String   @unique // absolute path
  size        BigInt   @default(0)
  mtimeMs     BigInt   @default(0) // lets rescans skip unchanged files
  container   String?
  codec       String?
  bitrate     Int?
  sampleRate  Int?
  channels    Int?
  durationSec Float    @default(0)
  title       String
  artist      String   @default("Unknown artist")
  albumArtist String?
  album       String?
  albumKey    String // groups tracks of one album
  genre       String?
  year        Int?
  trackNo     Int?
  discNo      Int?
  coverHash   String? // file name (sha1) of the extracted cover in <data>/music/covers
  source      String   @default("import") // upload | import
  status      String   @default("ready") // ready | missing
  createdAt   DateTime @default(now())
  playlistItems MusicPlaylistItem[]

  @@index([artist])
  @@index([albumKey])
  @@index([genre])
  @@index([status, createdAt])
}

model MusicPlaylist {
  id           String   @id @default(cuid())
  profileId    String
  name         String
  description  String?
  source       String   @default("manual") // manual | spotify
  sourceUrl    String?
  sourceId     String? // e.g. Spotify playlist id
  artworkUrl   String?
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items        MusicPlaylistItem[]

  @@index([profileId, updatedAt])
}

// One entry of a playlist. Imported entries keep their title/artist so they can be matched (again) to the library or
// found on an on-demand source later; `trackId` is the local match when there is one.
model MusicPlaylistItem {
  id          String        @id @default(cuid())
  playlistId  String
  position    Int
  trackId     String?
  title       String
  artist      String
  album       String?
  durationSec Float?
  artworkUrl  String?
  externalId  String? // Spotify track id
  isrc        String?
  // local | ondemand | unavailable | null (not checked yet), with a human reason for "unavailable"
  availability     String?
  availabilityNote String?
  candidate        String? // JSON: on-demand search result that matched (pinned for playback)
  checkedAt        DateTime?
  playlist    MusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track       MusicTrack?   @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@index([playlistId, position])
}

// The persistent play queue of a profile.
model MusicQueueItem {
  id          String  @id @default(cuid())
  profileId   String
  position    Int
  trackId     String? // local track
  title       String
  artist      String
  album       String?
  durationSec Float?
  artworkUrl  String?
  candidate   String? // JSON: pinned on-demand search result chosen by the user
  origin      String  @default("manual") // manual | playlist | autoplay | radio
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
}

model MusicQueueState {
  profileId     String   @id
  currentItemId String?
  shuffle       Boolean  @default(false)
  repeat        String   @default("off") // off | all | one
  autoplay      Boolean  @default(true)
  positionSec   Float    @default(0)
  shuffleOrder  String? // JSON string[] of queue item ids in shuffled play order
  updatedAt     DateTime @default(now()) @updatedAt
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model MusicPlay {
  id          String   @id @default(cuid())
  profileId   String
  trackId     String?
  title       String
  artist      String
  album       String?
  genre       String?
  durationSec Float?
  playedSec   Float    @default(0)
  completed   Boolean  @default(false)
  source      String   @default("local") // local | ondemand
  playedAt    DateTime @default(now())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, playedAt])
}
