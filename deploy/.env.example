# Copy to .env (install.sh does this for you and generates WORKER_TOKEN).
WORKER_TOKEN=change-me-openssl-rand-hex-32
# Host folder with your media; downloads and uploads are saved inside it.
MEDIA_PATH=./media
# Optional: image / tag to run (pin a version for stability, e.g. ghcr.io/nopethedev/rift:1.0.0)
# RIFT_IMAGE=ghcr.io/nopethedev/rift:latest
RIFT_PORT=3000
# Optional integrations (can also be set in Admin → Settings)
TMDB_API_KEY=
OPENSUBTITLES_API_KEY=
# HTTPS (docker compose --profile https up -d): your domain, then also set RIFT_BIND=127.0.0.1 and COOKIE_SECURE=true
# RIFT_DOMAIN=rift.example.com
# RIFT_BIND=127.0.0.1
COOKIE_SECURE=false
