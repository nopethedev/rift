# ---- Database -------------------------------------------------------------
# SQLite (default):      file:./data/rift.db
# PostgreSQL:            postgresql://rift:rift@localhost:5432/rift
# MySQL / MariaDB:       mysql://rift:rift@localhost:3306/rift
# The Prisma provider is chosen automatically from this URL (scripts/db.mjs).
DATABASE_URL="file:./data/rift.db"

# ---- Paths ------------------------------------------------------------------
DATA_DIR=./data          # subtitles cache, stored .torrent files
MEDIA_DIR=./media        # default library folder (more can be added in Admin -> Settings)
DOWNLOAD_DIR=./media/downloads

# ---- Metadata ---------------------------------------------------------------
# TMDB v3 API key or v4 read access token (https://www.themoviedb.org/settings/api). Can also be set in the UI.
# OpenSubtitles.com API key (opensubtitles.com -> Profile -> API consumers). Username/password and languages are set in Admin -> Settings.
OPENSUBTITLES_API_KEY=

TMDB_API_KEY=
# TMDB_BASE_URL=https://api.themoviedb.org/3

# ---- FFmpeg worker ------------------------------------------------------------
WORKER_URL=http://localhost:4100
# Shared secret between web and worker. Generate one: openssl rand -hex 32
WORKER_TOKEN=change-me
WORKER_PORT=4100
MAX_SESSIONS=2
TRANSCODE_DIR=./transcode
SESSION_IDLE_SECONDS=300
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ---- Security -----------------------------------------------------------------
# Set to true when serving over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# ---- On-demand torrent streaming -------------------------------------------------
STREAM_IDLE_SECONDS=60      # delete a stream's files after this long without a heartbeat (min 15)
STREAM_PREBUFFER_MB=6       # upper bound of the initial head pre-buffer
STREAM_MAX_SESSIONS=3
