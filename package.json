{
  "name": "rift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/db.mjs setup && next dev",
    "dev:worker": "tsx watch --env-file-if-exists=.env worker/index.ts",
    "build": "node scripts/db.mjs generate && next build",
    "start": "node scripts/db.mjs setup && next start",
    "start:worker": "tsx --env-file-if-exists=.env worker/index.ts",
    "db:generate": "node scripts/db.mjs generate",
    "db:setup": "node scripts/db.mjs setup",
    "db:migrate:dev": "node scripts/db.mjs migrate-dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediabunny/ac3": "^1.66.2",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^13.2.0",
    "clsx": "^2.1.1",
    "fluent-ffmpeg": "^2.1.3",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.77.0",
    "mariadb": "^3.5.5",
    "mediabunny": "^1.66.2",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "torrent-search-api": "^2.1.4",
    "webtorrent": "^3.0.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
